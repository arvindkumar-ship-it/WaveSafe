# --- Core ---
APP_BASE_URL=http://localhost:8000
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-random-secret
INTERNAL_API_KEY=change-me

# --- Database ---
DATABASE_URL=postgresql+psycopg://coastal:changeme@db:5432/coastal_safety
POSTGRES_DB=coastal_safety
POSTGRES_USER=coastal
POSTGRES_PASSWORD=changeme
TEST_DATABASE_URL=postgresql+psycopg://coastal:changeme@db:5432/coastal_safety_test

# --- Redis / Celery (broker=backend=same Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Module 3: ingestion sources ---
INCOIS_BASE_URL=
INCOIS_API_KEY=
INCOIS_POLL_SECONDS=900
SACHET_CAP_FEED_URL=
SACHET_API_KEY=
SACHET_POLL_SECONDS=120

# --- Module 3: raw payload storage ---
RAW_STORAGE_BACKEND=local
RAW_STORAGE_LOCAL_PATH=/var/data/raw_ingest
RAW_STORAGE_S3_BUCKET=
RAW_STORAGE_S3_PREFIX=raw-ingest

# --- Module 3/32: ops alerting ---
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_MIN_FAILURES=3

# --- Module 13: notifications ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# --- Frontend build-time (docker-compose passes this as a build ARG, not a runtime env) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Module 28: staging-only smoke test, leave blank locally ---
PUBLIC_API_BASE_URL=
SMOKE_TEST_PHONE=
SMOKE_TEST_OTP=
